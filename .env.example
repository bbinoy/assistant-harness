# Copy to .env and chmod 600 .env. Never commit it.

# --- required ---------------------------------------------------------------
# Your own Signal number (international format). The agent obeys ONLY your
# "Note to Self" messages, from this number. Everything else is ignored.
SIGNAL_OWNER_NUMBER=+10000000000
# Optional: give the assistant its OWN Signal account, so you chat with a contact that has its own
# name instead of with yourself (docs/SIGNAL-ACCOUNT.md). Unset: it talks to you in Note to Self.
# SIGNAL_ACCOUNT=+10000000001      # its number, or the account key from Signal Login
# SIGNAL_OWNER_ACI=                # only if Signal hides your number from it (see the guide)

# --- identity ---------------------------------------------------------------
OWNER_NAME=Alex            # how the assistant refers to you in prompts
ASSISTANT_NAME=Ted       # what it is called

# --- authentication (pick one) ----------------------------------------------
# login   (default) your stored `claude auth login`. The only mode that can use the
#         claude.ai connectors (Notion, Google Calendar, Gmail...).
# token   a long-lived token from `claude setup-token` (inference only, no connectors)
# api-key a metered Anthropic API key (inference only, no connectors)
HARNESS_AUTH=login
# CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=

# --- optional tuning (defaults shown) ---------------------------------------
# HARNESS_MODEL=sonnet           # model alias or full id for chat, brief and handler
# HEARTBEAT_MINUTES=15           # how often the mail heartbeat ticks
# HEARTBEAT_ACTIONS=live         # live = archive/alert/hand off; log = only record decisions
# HEARTBEAT_MAX_ARCHIVES=25      # archive cap per tick
# QUIET_START_HOUR=22            # the heartbeat idles from here ...
# QUIET_END_HOUR=7               # ... until here (local time)
# The daily brief and the radar: WHEN they run is decided by your chat's gate (a small model, default rules in src/persona.ts,
# tweakable by notes: "brief at 6:30", "no radar on weekends", except that the brief backstop below overrides a note); HOW stays in code.
# (SCHEDULER=legacy, the old fixed schedulers, is gone: a leftover value is ignored with one warning in the log.)
# BRIEF_START_HOUR=7             # only the default rule "brief from this hour" the gate is told
# BRIEF_MAX_ATTEMPTS=3           # attempts per day if the brief comes out incomplete (retried by code)
# BRIEF_BACKSTOP_HOUR=9          # no brief logged today by this hour -> run it anyway, whatever the gate says AND whatever a note says ("no brief today" does not stop it). 24: never. Until the backstop hour (or, with 24, three hours after BRIEF_START_HOUR) urgent mail waits for the brief; after that it is alerted
# CHAT_IDLE_RESET_HOURS=24       # backstop: start a fresh chat after this many idle hours (1-168); a new day already starts one after the nightly dream
# CHAT_COMPACT_GROWTH_TOKENS=100000 # compact a conversation (the owner's chat and every group alike) once it has grown this much beyond its first turn (tools, skills and prompts alone are ~50k for the owner, ~10k for a group) (5000-400000)
# CHAT_COMPACT_TOKENS=150000     # only for a session saved before the baseline was recorded: compact once a turn's context passes this (10000-500000)
# DAILY_BUDGET_USD=20            # background work pauses past this (SDK cost estimate)
# LAUNCHD_LABEL=com.you.ted-personal-assistant
# HARNESS_DATA_DIR=              # advanced: where state/, logs/ and memory/ live (default: the repo folder)
# SIGNAL_PORT=7583               # local port for the signal-cli daemon
# Settings are validated when the agent starts: a typo stops it with a clear message.

# What the model can see. Every tool it sees is re-sent on every model call, so hide what your
# skills never use (saves cost and time). A skill that needs a hidden tool will fail: keep
# these in step with your skills. Defaults shown.
# HIDDEN_CONNECTORS=mcp__claude_ai_Interactive_Brokers_IBKR,mcp__claude_ai_Gmail,mcp__claude_ai_Google_Drive,mcp__claude_ai_Google_Docs,mcp__claude_ai_Claude_Docs
# NOTION_TOOLS=notion-search,notion-fetch,notion-create-pages,notion-update-page
# MAILBIRD_TOOLS=summarize_all_inboxes,list_accounts,list_folders,list_conversations,search_conversations,get_message,get_conversation,list_attachments,get_attachment_content,archive_conversation,select_conversation,reply_to_conversation,reply_all_to_conversation,create_draft,update_draft,forward_conversation,send_message_now,get_send_status,send_self_briefing

# The proactive radar: every RADAR_MINUTES while you are awake, a model checks your calendar and
# what the heartbeat did, and messages you only when something deserves it (a meeting about to
# start with its prep, a clash). Defaults shown. Costs roughly $0.05-0.20 per run.
# PROACTIVE=on                   # off to disable
# RADAR_MINUTES=180              # the "every N hours" default rule the gate is told (30-720)
# MAX_PROACTIVE_PER_DAY=8        # hard cap on the radar's OWN messages per day (counted from its ledger lines in the log; mail alerts do not count)

# How long an "Approve?" question waits before it counts as "no". Several can be open at once.
# APPROVAL_TIMEOUT_MINUTES=15              # asked in a chat turn (1-1440); the turn being aborted also ends it
# BACKGROUND_APPROVAL_TIMEOUT_MINUTES=120  # asked by an unattended run: wake-up, brief, radar, handler (1-2880)

# A small model's second opinion on approvals. It can only skip the question for calendar events that
# touch nobody but you; sends, forwards, shares and anything with other people always ask. Changing an
# existing event is only ever skipped in chat. Every skipped question is announced on your phone.
#   off     never
#   shadow  it judges and logs, you still decide (`npm run report` shows how often it agreed)
#   chat    it may skip the question in chat, when the call matches what you just asked
#   broad   also for new events from background runs (default)
# AUTO_APPROVE=broad

# The nightly "dream": once a day, before the brief, a model with no tools reads what you told the
# assistant since the last time and proposes changes to its memory notes (new facts, merges, expired
# notes). Code applies only what is backed by your own words, snapshots first, and announces it.
# DREAM=on                       # off to disable
# MEMORY_MAX_NOTES=120           # how many notes background runs may read
# MEMORY_RUN_CHARS=24000         # ... and how many characters of them, per run

# Every message in the assistant's chat, yours and its (and your reactions), is logged in logs/messages.jsonl so a
# reaction can be matched to its message, the assistant can search the past, and the dream can learn from it. The log is bounded by size: past the
# limit the oldest messages are folded into one short summary written by a small model.
# MESSAGE_LOG_MB=1               # 0.01-100
# SUMMARY_WORDS=60               # length of that summary

# Pictures need no setup: Ted shrinks them (and converts iPhone HEIC) with macOS's built-in sips, then shows them to the model.
# Without sips only a small JPEG, PNG, WebP or GIF works. Up to 20 MB in, 5 pictures per turn, longest side 1568 px.

# Voice messages are transcribed on this Mac with whisper.cpp and ffmpeg (brew install whisper-cpp ffmpeg),
# using a Whisper model file (about 470 MB, multilingual):
#   mkdir -p ~/.cache/ted-personal-assistant && curl -L -o ~/.cache/ted-personal-assistant/ggml-small.bin https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-small.bin
# WHISPER_MODEL=~/.cache/ted-personal-assistant/ggml-small.bin

# Spoken replies: the assistant may answer by voice when it fits, whatever you sent (local text to speech with
# Kokoro, nothing leaves the Mac). Needs the assistant's own Signal account and `scripts/setup-tts.sh` (about 400 MB).
# VOICE_REPLIES=on               # off to always answer in text
# TTS_VOICE=am_onyx              # any Kokoro voice: am_* American male, bm_* British male, af_*, bf_* female.
# TTS_SPEED=0.95                 # 0.5-2
# Optional REMOTE speech instead of Kokoro (docs/REMOTE-TTS.md). This sends the words Ted speaks to a third party or to
# your own server; only use a cloned voice you have the rights and consent for. Keys stay in this file only.
# TTS_PROVIDER=kokoro            # kokoro | elevenlabs | http
# TTS_FALLBACK=none              # none: send text when remote speech fails; kokoro: speak locally instead
# TTS_TIMEOUT_SECONDS=60
# ELEVENLABS_API_KEY=            # with TTS_PROVIDER=elevenlabs
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# TTS_HTTP_URL=https://tts.example.com/say   # with TTS_PROVIDER=http (https; http only for localhost)
# TTS_HTTP_TOKEN=                # optional bearer token
# TTS_HTTP_VOICE=                # optional "voice" field
# TTS_HTTP_REFERENCE_ID=         # optional "reference_id": names the reference recording on YOUR server

# Group chats (needs the assistant's own Signal account): add it to any group you are in and it joins in, answering
# when @mentioned or when it fits, with NO access to your mail, calendar or notes. It shares your personality (style notes) and keeps its own notes and
# history per group.
# A group you are not a member of gets no answers. No setup needed.
# GROUP_PARTICIPATION=free       # free: a small model judges every message; tagged: only when @mentioned or replied to
# SETTLE_SECONDS=2              # every chat (yours and groups): wait this long after a message for a burst to end, then answer all of it as one turn. GROUP_DEBOUNCE_SECONDS still works as the old name
# SETTLE_MAX_SECONDS=10          # ...but never longer than this since the burst's first message: continuous chatter is answered anyway (later messages join the next turn)
# WARM=on                        # keep warm model processes ready so an answer skips the 3 s start-up: your chat, the group that spoke last and a small one for the group gate, and one each for the two approval judges (at most five, usually three, about 200 MB resident each, no tokens). off: every turn starts cold
# WARM_IDLE_MINUTES=60           # drop a warm process after this long without a message (1 to 1440); the next message then starts cold
# (GROUP_WARM and GROUP_WARM_IDLE_MINUTES are the deprecated names of these two, still read when WARM / WARM_IDLE_MINUTES are unset; they will be removed in the next release)
# GATE_MAX_DELAY_SECONDS=4      # the most the group gate may delay an answer to be natural ("typing…" shows meanwhile, so long pauses only make it late); 0: never
# GROUP_LOG_MB=0.5              # each group's history, size-bounded like the main message log

# Wake-ups: on every heartbeat tick a small model looks at each conversation (your chat, every group) whose "next look" has come, or
# where something was said or a note changed, and decides whether to do something on its own ("every morning post a fun fact" in a note).
# Your chat is left alone in the quiet hours. Pause and the daily budget apply.
# WAKEUPS=on                     # off to disable the gate's looks (the brief backstop and retries still run)

# Timing constants (defaults shown; they used to be fixed in the code). Rarely worth changing.
# GROUP_STICKY_MINUTES=30         # a group member who addressed the assistant and got no answer (paused, over budget) is dropped after this long (1-1440)
# GROUP_NOTICE_MINUTES=10         # a failure is explained in a group at most this often (0: every time)
# GROUP_MEMBER_CACHE_MINUTES=5    # how long "you are in this group" is remembered before signal-cli is asked again (0-1440)
# SLOW_REPLY_SECONDS=20           # an answer that took longer than this is threaded under the message it answers (0-600)
# ECHO_WINDOW_MINUTES=5          # text we sent that comes back within this long is our own echo, not you (1-60)
# WARM_REFRESH_MINUTES=25        # your chat's warm process is renewed this often, so it is fresh after a quiet hour (1-1440)
# BRIEF_RETRY_GAP_MINUTES=10     # an incomplete brief is retried after this long (1-240)
# BRIEF_PENDING_GRACE_HOURS=3    # with BRIEF_BACKSTOP_HOUR=24: urgent mail waits for the brief this many hours after BRIEF_START_HOUR (0-12)
# SEEN_MAIL_DAYS=14              # how long the heartbeat remembers a mail it has seen (1-365)
# NOTICE_AGE_HOURS=24            # what the assistant sent on its own stays known to the chat this long (1-168)
# COMPACT_BACKOFF_MINUTES=60     # after a failed compaction, no new try for this long (1-1440)
# COMPACT_QUIET_MINUTES=5         # a grown conversation is compacted in the background once nobody has written for this long (1-240); right after a reply only if it grew 1.5 times past the limit
